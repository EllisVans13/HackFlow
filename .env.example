# Generate independent values; do not commit .env.
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
DATABASE_URL=postgresql+psycopg://hackflow:replace-with-random-alphanumeric-password@localhost:5432/hackflow
# Local HTTP only: false. Production HTTPS: true.
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
SITE_DOMAIN=hackflow.example.com
# Optional SMTP for password recovery:
MAIL_SERVER=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
# Development single process only. Compose uses shared Redis.
RATELIMIT_STORAGE_URI=memory://
